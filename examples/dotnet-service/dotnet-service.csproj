<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serilog integration for ASP.NET Core ILogger -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />

    <!-- OpenTelemetry hosting for builder.Services.AddOpenTelemetry() -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
  </ItemGroup>

  <!-- Reference the Centricity Observability SDK -->
  <ItemGroup>
    <ProjectReference Include="..\..\dotnet-sdk\Centricity.Observability.csproj" />
  </ItemGroup>
</Project>
